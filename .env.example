# 生成随机签名密钥：python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# 复制为 .env 后填入自己的密钥；切勿把 .env 提交到仓库
DJANGO_SECRET_KEY=please-generate-a-random-string
FASTAPI_SECRET_KEY=please-generate-a-random-string
FASTAPI_JWT_ALGORITHM=HS256

DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=procurement

# 邮件（可选）：不填则使用控制台后端，验证码打印在终端，不发送真实邮件
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=
